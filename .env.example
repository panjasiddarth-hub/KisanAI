# ====================================================================
# KisanAI Full-Stack Production Environment Variables
# Copy this file to .env and fill in your custom credentials
# ====================================================================

# Port for Backend API
PORT=5000

# Security: Generate a 64-char random string:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-secure-random-secret-key-32-chars-min

# Database: MongoDB Atlas connection string (or use default docker compose mongo)
MONGODB_URI=mongodb://mongo:27017/kisanai
KISANAI_IN_MEMORY=0

# Google Gemini API Key for hybrid agronomist explanations & leaf vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Python ML Microservice Internal / External URL
ML_SERVICE_URL=http://ml-service:8000
