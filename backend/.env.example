# Copy this file to .env and fill values. These sample settings are for local development —
# without MONGODB_URI the API runs in in-memory mode; without GEMINI_API_KEY the
# agents use built-in template explanations instead of AI-written ones.

PORT=5000
JWT_SECRET=change-me-in-production
# In production, provide a randomly generated secret of at least 32 characters.

# Comma-separated exact frontend origins. Required when NODE_ENV=production.
CORS_ORIGINS=
# Number of trusted reverse-proxy hops; leave 0 unless the hosting topology is known.
TRUST_PROXY_HOPS=0

# MongoDB — leave empty for in-memory mode, or paste a MongoDB Atlas free-tier URI
MONGODB_URI=

# Google Gemini (free key: https://aistudio.google.com/apikey) — optional, hybrid AI explanations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional official Soil Health Card Portal crop/fertilizer recommendations.
# Obtain an authorized token before enabling; requests can include state, official crop ID, and farm NPK soil readings.
SHC_API_URL=https://soilhealth4.dac.gov.in/
SHC_API_TOKEN=
