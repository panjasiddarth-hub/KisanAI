# Copy this file to .env and fill values. All values are OPTIONAL for a local demo —
# without MONGODB_URI the API runs in in-memory mode; without GEMINI_API_KEY the
# agents use built-in template explanations instead of AI-written ones.

PORT=5000
JWT_SECRET=change-me-in-production

# MongoDB — leave empty for in-memory mode, or paste a MongoDB Atlas free-tier URI
MONGODB_URI=

# Google Gemini (free key: https://aistudio.google.com/apikey) — optional, hybrid AI explanations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
